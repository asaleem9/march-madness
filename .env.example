# Neon (run `neon link` then `neon deploy` to fill these in automatically)
DATABASE_URL=                     # pooled connection string (app traffic)
DATABASE_URL_UNPOOLED=            # direct connection (migrations, scripts)
NEON_AUTH_BASE_URL=               # Neon Auth URL for the branch (from `neon neon-auth status`)
NEON_AUTH_COOKIE_SECRET=          # openssl rand -base64 32

# Operations
CRON_SECRET=                      # also add as a GitHub Actions repository secret
ADMIN_EMAILS=you@example.com

# Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=     # npm run generate-vapid
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
EMAIL_FROM="March Madness <brackets@example.com>"   # verified Resend sender
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
