# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Operations
CRON_SECRET=                      # also add as a GitHub Actions repository secret
ADMIN_EMAILS=you@example.com

# Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=     # npm run generate-vapid
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
EMAIL_FROM="March Madness <brackets@example.com>"   # verified Resend sender
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
