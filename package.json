{
  "name": "march-madness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "generate-vapid": "npx tsx scripts/generate-vapid-keys.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --testPathPattern='api.*test'",
    "test:components": "vitest run --testPathPattern='components.*test'",
    "test:middleware": "vitest run --testPathPattern='middleware.*test'",
    "test:all": "vitest run",
    "db:rollover": "npx tsx scripts/rollover.ts",
    "db:import-json": "npx tsx scripts/import-bracket-json.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neondatabase/auth": "^0.6.0-beta",
    "@tanstack/react-query": "^5.90.21",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.7",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
